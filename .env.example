POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=catalog

S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret-key
S3_BUCKET=products

INTERNAL_TOKEN=change-me

# Токен от @BotFather. Без него бот не стартует.
BOT_TOKEN=

# Telegram user id администраторов через запятую.
# Узнать свой id: @userinfobot
ADMIN_IDS=

# Публичный https-адрес каталога. Telegram открывает Mini App только по https.
WEBAPP_URL=https://catalog.example.com
